# Vendor mode: fake uses sample images; live calls upstream OpenAI-compatible image APIs.
AMAM_VENDOR_MODE=live
AMAM_VENDOR_TIMEOUT_MS=120000

# Frontend slots map to SenseNova U1.5. Leave a slot empty to fail that model with vendor_unconfigured.
# Base URL: https://token.sensenova.cn/v1
# Default/fast: sensenova-u1.5-fast · quality: sensenova-u1.5-lite

AMAM_VENDOR_NANO_BANANA_API_KEY=your-api-key-here
AMAM_VENDOR_NANO_BANANA_BASE_URL=https://token.sensenova.cn/v1
AMAM_VENDOR_NANO_BANANA_MODEL=sensenova-u1.5-fast

AMAM_VENDOR_NANO_PRO_API_KEY=your-api-key-here
AMAM_VENDOR_NANO_PRO_BASE_URL=https://token.sensenova.cn/v1
AMAM_VENDOR_NANO_PRO_MODEL=sensenova-u1.5-lite

AMAM_VENDOR_SEEDREAM_API_KEY=your-api-key-here
AMAM_VENDOR_SEEDREAM_BASE_URL=https://token.sensenova.cn/v1
AMAM_VENDOR_SEEDREAM_MODEL=sensenova-u1.5-fast

AMAM_VENDOR_GPT_IMAGE_API_KEY=your-api-key-here
AMAM_VENDOR_GPT_IMAGE_BASE_URL=https://token.sensenova.cn/v1
AMAM_VENDOR_GPT_IMAGE_MODEL=sensenova-u1.5-lite
